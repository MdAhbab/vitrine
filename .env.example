# ── Vitrine environment (copy to .env and fill in) ───────────────────────────
# See backend.md §15 for descriptions.

# core
ENV=local
SECRET_KEY=change-me-to-a-long-random-string
# DEFAULT = SQLite (zero setup). Postgres later: swap the line below.
DATABASE_URL=sqlite+aiosqlite:///./vitrine.db
# DATABASE_URL=postgresql+asyncpg://vitrine:vitrine@localhost:5432/vitrine
FRONTEND_ORIGIN=http://localhost:5173

# infra selection — 'memory' runs with NO Postgres/Redis (SQLite monolith dev).
# Switch both to 'redis' (and set REDIS_URL) when running real microservices.
EVENT_BUS=memory
CACHE=memory
REDIS_URL=redis://localhost:6379/0

# auth
JWT_ALG=HS256
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# openai  (server-side only — never expose to the browser)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_DAILY_LIMIT_USD=5
AGENT_MAX_RETRIES=2
AGENT_RUN_BUDGET_TOKENS=20000

# gemini fallback — used automatically when OpenAI errors or hits quota.
# Each Gemini model has its own quota, so the client walks GEMINI_MODELS in
# order until one answers.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-2.5-pro,gemini-3-pro-preview,gemini-3.1-pro-preview
GEMINI_EMBED_MODEL=gemini-embedding-001

# ollama — local, free, last in the chain. Only answers when OpenAI and Gemini
# are missing or failing, so leaving it on costs nothing when a key works.
# OLLAMA_MODEL must (a) support real tool calling — Repo-Intake and Verification
# dispatch typed tools — and (b) put its answer in `content`, not in a
# `reasoning` field. qwen2.5 clears both; llama3.2 fails (a), qwen3's thinking
# mode fails (b). Size it to fit VRAM or it silently spills to CPU.
#   ollama pull qwen2.5:3b
#   ollama pull nomic-embed-text
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# payments  (mock now, Stripe-ready)
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# hosting / previews  (allow-listed hosts for embedded sandboxed demos)
ALLOWED_PREVIEW_HOSTS=vercel.app,preview.vitrine.app,demo.vitrine.app

# security — set to true ONLY when a trusted reverse proxy (the nginx in
# run_onVM.py) terminates connections. It makes the rate limiter read the real
# client from X-Forwarded-For; behind a proxy without it, every visitor shares
# one bucket. Leave false on a directly-exposed server, where the header is
# attacker-controlled. run_onVM.py sets this for you on the VM.
TRUST_PROXY_HEADERS=false

# negotiation — max concurrent AI buyer-reps per buyer (see AGENTS.md)
MAX_ACTIVE_REPS_PER_BUYER=2
